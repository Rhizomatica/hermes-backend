# Hermes Backend — Environment Configuration
# Copy this file to .env and adjust values

# Database
DATABASE_PATH=./data/hermes.sqlite

# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# CORS
CORS_ORIGINS=*

# Radio Driver (simulated | sbitx)
RADIO_DRIVER=simulated

# Database Adapter (sqlite | postgres)
DB_ADAPTER=sqlite

# JWT RS256
# Generate keys: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
