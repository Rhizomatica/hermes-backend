# Hermes Webservice — Environment Configuration
# Copy this file to .env and adjust values for your deployment.

# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug                     # trace | debug | info | warn | error | fatal

# ─── Database (SQLite) ────────────────────────────────────
DATABASE_PATH=./data/hermes.sqlite
SQLITE_WAL=true                     # Enable WAL mode (recommended)
SQLITE_BUSY_TIMEOUT=5000            # Busy timeout in ms
SQLITE_SYNCHRONOUS=NORMAL           # FULL | NORMAL | OFF (NORMAL recommended for Pi 4)

# ─── Auth (JWT RS256) ─────────────────────────────────────
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_EXPIRY=15m         # Access token lifetime
JWT_REFRESH_TOKEN_EXPIRY=7d         # Refresh token lifetime
JWT_ISSUER=hermes-webservice
BCRYPT_COST=12

# ─── TLS (HTTPS) ──────────────────────────────────────────
TLS_ENABLED=false
TLS_CERT_PATH=./certs/cert.pem
TLS_KEY_PATH=./certs/key.pem

# ─── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_GLOBAL=100               # Max requests per minute (global)
RATE_LIMIT_AUTH=5                   # Max requests per minute (auth routes)
RATE_LIMIT_WEBSOCKET=10             # Max concurrent WebSocket connections

# ─── Radio (sBitx CLI) ────────────────────────────────────
RADIO_DRIVER=sbitx-cli              # sbitx-cli | simulated
SBITX_CLI_PATH=/usr/local/bin/sbitx
SBITX_CLI_TIMEOUT=5000              # Command timeout in ms

# ─── Telemetry ────────────────────────────────────────────
TELEMETRY_INTERVAL=1000             # Telemetry snapshot interval in ms (1000 = 1 Hz)
TELEMETRY_RETENTION_DAYS=90

# ─── Storage (Attachments) ────────────────────────────────
ATTACHMENT_STORAGE_PATH=./data/attachments
ATTACHMENT_MAX_SIZE=52428800        # 50 MB in bytes

# ─── GPS / Geolocation ────────────────────────────────────
GPS_RETENTION_DAYS=365
GPS_DEVICE_PATH=/dev/ttyAMA0

# ─── Clock Sync ───────────────────────────────────────────
CLOCK_LAST_KNOWN_PATH=./data/last_known_time
CLOCK_MAX_DRIFT_SECONDS=60          # Max acceptable clock drift before sync required

# ─── Metrics (Prometheus) ─────────────────────────────────
METRICS_ENABLED=false               # Disabled by default on Pi 4 to save resources
METRICS_PORT=9090

# ─── WebRTC (Optional — disabled by default) ──────────────
ENABLE_WEBRTC=false
WEBRTC_ANNOUNCED_IP=127.0.0.1

# ─── Retention ────────────────────────────────────────────
RETENTION_AUDIT_DAYS=730            # 2 years
RETENTION_SYNC_QUEUE_DAYS=30
RETENTION_DELETED_MESSAGES_DAYS=90
RETENTION_SESSIONS_DAYS=7
RETENTION_JOBS_DAYS=30
RETENTION_CRON_INTERVAL=86400       # Run retention cleanup every N seconds (86400 = daily)